# Generate a private token with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
EDR_API_TOKEN=replace-with-a-long-random-token

# Relative paths are resolved from the repository root.
EDR_DATABASE_PATH=data/mini_edr.db

# An endpoint is marked offline after this many seconds without a heartbeat.
EDR_OFFLINE_AFTER_SECONDS=15

# Keep 127.0.0.1 for same-machine development. Use 0.0.0.0 only in an
# isolated lab network when another VM must connect to this server.
EDR_HOST=127.0.0.1
EDR_PORT=5000
